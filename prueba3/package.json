{
  "name": "cardinal-ai-local",
  "version": "1.0.1",
  "description": "Cliente local de IA con diseño Cardinal para LM Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "author": "StormGamesStudios <meliodas.aitor@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acierto-incomodo/CardinalAI_WinAgent.git"
  },
  "build": {
    "appId": "com.stormgamesstudios.cardinalai",
    "productName": "CardinalAI Local",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "acierto-incomodo",
        "repo": "CardinalAI_WinAgent"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.png",
      "publish": ["github"]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "differentialPackage": true,
      "shortcutName": "CardinalAI Local",
      "include": "installer.nsh",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "icon": "icon.png",
      "publish": ["github"],
      "artifactName": "${productName}-Setup.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1"
  }
}